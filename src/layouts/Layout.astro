---
import '../styles/global.css';
import '../styles/funnel.css';
const { title = 'Бриф для развития бизнеса' } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Заполните бриф — поможем раскрыть сильные стороны бизнеса и подготовить основу для сайта и продвижения." />
    <link rel="icon" type="image/svg+xml" href="/DL_Brief/images/dl-mark.svg" />
    <meta name="theme-color" content="#0c1820" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body><slot /></body>
</html>
